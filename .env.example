# NextAuth Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Neon PostgreSQL)
DATABASE_URL=

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# LLM Configuration (for caption enhancement)
# Provider: 'openai' or 'openrouter' (default: 'openai')
LLM_PROVIDER=openai
# API key for the selected provider
LLM_API_KEY=
# Optional: Model to use (defaults: gpt-4 for OpenAI, anthropic/claude-3.5-sonnet for OpenRouter)
# LLM_MODEL=gpt-4
# Optional: Custom base URL (auto-set for known providers)
# LLM_BASE_URL=

# Backward compatibility: OPENAI_API_KEY will be used as fallback for LLM_API_KEY
OPENAI_API_KEY=

# Replicate API (for Flux image generation)
REPLICATE_API_TOKEN=

# Optional: Custom Flux model (defaults to black-forest-labs/flux-1.1-pro)
# REPLICATE_FLUX_MODEL=your-username/your-custom-flux-model

# ===== OpenRouter Example =====
# To use OpenRouter instead of OpenAI:
# LLM_PROVIDER=openrouter
# LLM_API_KEY=sk-or-v1-xxx
# LLM_MODEL=anthropic/claude-3.5-sonnet
# (or any model from https://openrouter.ai/models)
